<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivPerson"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:background="@drawable/ronaldo"
            android:scaleType="fitCenter"
            android:contentDescription="Cristiano Ronaldo" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cristiano Ronaldo"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="15dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="מקור ההשראה שלי"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="למה בחרתי בו?"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="right"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/tvStory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="בחרתי בכריסטיאנו רונאלדו כי הוא מעורר בי השראה בזכות ההתמדה, המשמעת וההשקעה שלו. הוא התחיל עם חלום גדול ועבד קשה כדי להפוך לאחד משחקני הכדורגל הטובים בעולם. אני לומד ממנו שאסור לוותר על החלומות שלנו ושצריך להאמין בעצמנו גם כשקשה."
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:gravity="right"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>