
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD"
    android:padding="20dp">

    <!-- מתג -->

    <!-- תמונה ראשונה -->

    <!-- תמונה שנייה -->

    <!-- פס הזזה -->

    <!-- כפתור ראשון -->

    <Switch
        android:id="@+id/switchButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="448dp"
        android:checked="false"
        android:text="הצג כפתורים"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivFlag"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:alpha="1"
        android:contentDescription="דגל ישראל"
        android:scaleType="fitCenter"
        android:src="@drawable/israel_flag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="185dp" />

    <ImageView
        android:id="@+id/ivSecond"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:alpha="0"
        android:contentDescription="תמונה שנייה"
        android:scaleType="fitCenter"
        android:src="@drawable/ronaldo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="185dp" />

    <!-- כפתור שני -->
    <SeekBar
        android:id="@+id/seekImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:max="100"
        android:progress="100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivFlag" />

    <Button
        android:id="@+id/btnIsrael"
        android:layout_width="180dp"
        android:layout_height="45dp"
        android:layout_marginTop="15dp"
        android:backgroundTint="#8000A8"
        android:text="אני אוהב את ישראל"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seekImage" />

    <Button
        android:id="@+id/btnSecond"
        android:layout_width="180dp"
        android:layout_height="45dp"
        android:text="עקוב"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:backgroundTint="#8000A8"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnIsrael"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
